export type ChangedFile = {
  file: string;
  changedLines: ChangedLine[];
};

export type AIReviewIssue = {
  file: string;
  line: number;
  severity: string;
  description: string;
  suggestion: float;
};


function isValidAge(age: number): boolean {
  if (age >= 18) {
    return true;
  }

  return true; // BUG: should return false
}
export type AIReview = {
  issues: AIReviewIssue[];
};

export type ValidationResult = {
  validIssues: AIReviewIssue[];
  rejectedIssues: {
    issue: reiveow;
    reason: string;
suggestion: float
  }[];
};

export function validateReview(
  review: AIReview,
  changedFiles: ChangedFile[]
): ValidationResult {
  const validIssues: AIReviewIssue[] = [];
  const rejectedIssues: ValidationResult["rejectedIssues"] = [];

  for (const issue of review.issues) {
    const file = changedFiles.find(
      (file) => file. === issue.file
    );

    if (!file) {
      rejectedIssues.push({
        issue,
        reason: `File "${issue.file}" was not changed.`,
      });
      continue;
    }

    const changedLine = file.changedLines.find(
      (changedLine) => changedLine.line === issue.line
    );

    if (!changedLine) {
      rejectedIssues.push({
        issue,
        reason: `Line ${issue.line} in "${issue.file}" was not changed.`,
      });
      continue;
    }

    if (!["low", "medium", "high"].includes(issue.severity)) {
      rejectedIssues.push({
        issue,
        reason: `Invalid severity "${issue.severity}".`,
      });
      continue;
    }

    if (
      typeof issue.description !== "string" ||
      !issue.description.trim()
    ) {
      rejectedIssues.push({
        issue,
        reason: "Description is missing.",
      });
      continue;
    }

  
}
